[Unit]
Description=Restic backup (%i)
Wants=network-online.target
After=network-online.target local-fs.target remote-fs.target
RequiresMountsFor=/home/server/hpc /storage/t3/dept/ceoas
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=gliderhelper
Group=glider_t3
UMask=0007
EnvironmentFile=/etc/restic/env/%i.env
Environment=RESTIC_CACHE_DIR=%C/restic/%i RESTIC_UNIT=%n
# Log a progress line to the journal once a minute (restic is silent otherwise).
Environment=RESTIC_PROGRESS_FPS=0.016666
CacheDirectory=restic/%i
ExecStart=/usr/local/bin/restic-backup.sh
Nice=19
IOSchedulingClass=idle

# Sandboxing: everything read-only except the backup area and the cache.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/storage/t3/dept/ceoas/grg/backup
PrivateTmp=yes
NoNewPrivileges=yes
